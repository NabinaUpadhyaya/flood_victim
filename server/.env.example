PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=insec_data

JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

# Email (SMTP) Configuration (Optional - if omitted, OTP is shown in console & local dev banner)
# For Gmail, use an App Password generated in your Google Account security settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM="इन्सेक (INSEC) प्रणाली" <noreply@insec.org.np>
